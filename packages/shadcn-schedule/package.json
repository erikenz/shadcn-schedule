{
  "name": "shadcn-schedule",
  "version": "0.3.0",
  "description": "The modern, Temporal-backed calendar and scheduling engine for Tailwind & shadcn.",
  "keywords": [
    "agenda",
    "booking",
    "calendar",
    "react",
    "schedule",
    "scheduler",
    "shadcn",
    "tailwind",
    "temporal"
  ],
  "homepage": "https://github.com/erikenz/shadcn-schedule#readme",
  "bugs": {
    "url": "https://github.com/erikenz/shadcn-schedule/issues"
  },
  "license": "MIT",
  "author": "Erik Enz <46247842+erikenz@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikenz/shadcn-schedule.git",
    "directory": "packages/shadcn-schedule"
  },
  "files": [
    "dist",
    "styles",
    "assets"
  ],
  "type": "module",
  "sideEffects": [
    "./styles/globals.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins/agenda": {
      "import": {
        "types": "./dist/plugins/agenda/index.d.ts",
        "default": "./dist/plugins/agenda/index.js"
      },
      "require": {
        "types": "./dist/plugins/agenda/index.d.cts",
        "default": "./dist/plugins/agenda/index.cjs"
      }
    },
    "./plugins/drag-to-create": {
      "import": {
        "types": "./dist/plugins/drag-to-create/index.d.ts",
        "default": "./dist/plugins/drag-to-create/index.js"
      },
      "require": {
        "types": "./dist/plugins/drag-to-create/index.d.cts",
        "default": "./dist/plugins/drag-to-create/index.cjs"
      }
    },
    "./plugins/recurrence": {
      "import": {
        "types": "./dist/plugins/recurrence/index.d.ts",
        "default": "./dist/plugins/recurrence/index.js"
      },
      "require": {
        "types": "./dist/plugins/recurrence/index.d.cts",
        "default": "./dist/plugins/recurrence/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./styles/globals.css": "./styles/globals.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "format": "oxfmt --write",
    "lint": "oxlint",
    "prepack": "tsdown",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.73.0",
    "rrule-temporal": "2.2.9",
    "temporal-polyfill": "1.0.8",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cross-env": "10.1.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "jsdom": "31.0.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-plugin-react-doctor": "0.9.23",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "react-doctor": "0.9.23",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "ultracite": "8.2.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
